# Copy to .env.local for local development. Never commit real values.

# Strapi (cms/). Local: http://localhost:1337. The token is a read-only API token (Strapi → Settings → API Tokens).
# Server-only; never prefix with NEXT_PUBLIC_.
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Canonical origin for canonicals, sitemap.xml and robots.txt. Defaults to https://thejetlagchronicles.com.
NEXT_PUBLIC_SITE_URL=

# Set to "true" only at launch (issue 18). Until then every page is noindex and robots.txt blocks crawlers.
SITE_LIVE=

# Pre-launch password gate (src/proxy.ts). Set BOTH in Vercel until launch. Leave both empty locally.
# Setting only one blocks the whole site (503). Deleted at launch (issue 18).
SITE_USER=
SITE_PASSWORD=

# Shared secret for the Strapi publish webhook (issue 11). Strapi sends "Authorization: Bearer <this>" to
# /api/revalidate. Use a long random value; set the same value in the Strapi webhook header.
REVALIDATE_SECRET=
